{
  "name": "mcp-lmt-bridge",
  "displayName": "MCP-LMT Bridge",
  "description": "Bridge between MCP-capable AI chat extensions and LanguageModelTools API",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0",
    "node": "^22.14.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "clean": "rimraf dist out",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "pretest": "npm run clean && npm run compile",
    "test": "node ./dist/test/runTest.js",
    "test:compile": "webpack --config webpack.config.js",
    "test:watch": "webpack --config webpack.config.js --watch"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^22.14.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vscode/test-electron": "^2.3.4",
    "eslint": "^8.26.0",
    "mocha": "^10.2.0",
    "rimraf": "^5.0.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "ws": "^8.16.0",
    "fast-glob": "^3.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/username/mcp-lmt-bridge.git"
  },
  "publisher": "your-publisher-name"
}